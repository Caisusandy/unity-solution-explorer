{
  "name": "unity-solution-explorer",
  "displayName": "Unity Solution Explorer",
  "description": "Browse Unity .sln/.slnx/.csproj in the sidebar; ignores non-Unity editor files; drag-drop move within assembly, open in editor/Chat; supports .cs/.shader/.xml and right-click add/rename/delete. 在侧边栏按 .sln/.slnx/.csproj 展示 Unity 解决方案与程序集结构，支持树内拖拽移动（确认后）、拖入编辑器/聊天、多选拖拽，以及 .cs/.shader/.xml/.txt/.json、右键新建/重命名/删除、排除项目配置",
  "version": "1.1.6",
  "publisher": "Seacysin",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnx"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "unitySolutionExplorer",
          "title": "Unity Solution Explorer",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "unitySolutionExplorer": [
        {
          "id": "unitySolutionExplorerView",
          "name": "Unity Solution Explorer"
        }
      ]
    },
    "commands": [
      {
        "command": "unitySolutionExplorer.refresh",
        "title": "Refresh Solution",
        "icon": "$(refresh)"
      },
      {
        "command": "unitySolutionExplorer.newFile",
        "title": "New File"
      },
      {
        "command": "unitySolutionExplorer.renameFolder",
        "title": "Rename Folder"
      },
      {
        "command": "unitySolutionExplorer.newFolder",
        "title": "New Folder"
      },
      {
        "command": "unitySolutionExplorer.deleteFolder",
        "title": "Delete Folder"
      },
      {
        "command": "unitySolutionExplorer.revealFolderInExplorer",
        "title": "Reveal Folder in System Explorer"
      },
      {
        "command": "unitySolutionExplorer.copyFolderPath",
        "title": "Copy Absolute Path"
      },
      {
        "command": "unitySolutionExplorer.renameFile",
        "title": "Rename File"
      },
      {
        "command": "unitySolutionExplorer.deleteFile",
        "title": "Delete File"
      },
      {
        "command": "unitySolutionExplorer.revealFileInExplorer",
        "title": "Reveal in System Explorer"
      },
      {
        "command": "unitySolutionExplorer.copyFilePath",
        "title": "Copy Absolute Path"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "unitySolutionExplorer.refresh",
          "when": "view == unitySolutionExplorerView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "unitySolutionExplorer.newFile",
          "when": "view == unitySolutionExplorerView && viewItem == folder",
          "group": "1_new"
        },
        {
          "command": "unitySolutionExplorer.newFolder",
          "when": "view == unitySolutionExplorerView && viewItem == folder",
          "group": "1_new"
        },
        {
          "command": "unitySolutionExplorer.renameFolder",
          "when": "view == unitySolutionExplorerView && viewItem == folder",
          "group": "2_edit"
        },
        {
          "command": "unitySolutionExplorer.deleteFolder",
          "when": "view == unitySolutionExplorerView && viewItem == folder",
          "group": "2_edit"
        },
        {
          "command": "unitySolutionExplorer.revealFolderInExplorer",
          "when": "view == unitySolutionExplorerView && viewItem == folder",
          "group": "3_open"
        },
        {
          "command": "unitySolutionExplorer.copyFolderPath",
          "when": "view == unitySolutionExplorerView && viewItem == folder",
          "group": "3_open"
        },
        {
          "command": "unitySolutionExplorer.renameFile",
          "when": "view == unitySolutionExplorerView && viewItem == file",
          "group": "2_edit"
        },
        {
          "command": "unitySolutionExplorer.deleteFile",
          "when": "view == unitySolutionExplorerView && viewItem == file",
          "group": "2_edit"
        },
        {
          "command": "unitySolutionExplorer.revealFileInExplorer",
          "when": "view == unitySolutionExplorerView && viewItem == file",
          "group": "3_open"
        },
        {
          "command": "unitySolutionExplorer.copyFilePath",
          "when": "view == unitySolutionExplorerView && viewItem == file",
          "group": "3_open"
        }
      ]
    },
    "configuration": {
      "title": "Unity Solution Explorer",
      "properties": {
        "unitySolutionExplorer.excludeProjects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Project (assembly) names to hide from Solution Explorer. Merged with .vscode/unity-solution-explorer.json"
        },
        "unitySolutionExplorer.additionalFileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra file extensions to show in the tree besides built-in types (.cs, .shader, .xml, .txt, .json). Merged with additionalFileExtensions in .vscode/unity-solution-explorer.json"
        },
        "unitySolutionExplorer.extraSolutionFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra folders at solution root (paths relative to workspace root), e.g. [\".cursor\", \".claude\"]. Prefer project .vscode/settings.json"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^3.0.0"
  },
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Seacysin/unity-solution-explorer.git"
  },
  "homepage": "https://github.com/Seacysin/unity-solution-explorer#readme",
  "bugs": {
    "url": "https://github.com/Seacysin/unity-solution-explorer/issues"
  }
}
